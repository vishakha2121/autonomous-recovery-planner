cd "C:\path\to\autonomous-recovery-planner"

git init
git config --global user.name "vishakha2121"
git config --global user.email "your-email@gmail.com"

# .gitignore file manually banao (upar wala content)

git add .
git commit -m "Initial commit: AI Autonomous Disaster Recovery Planner"
git branch -M main
git remote add origin https://github.com/vishakha2121/autonomous-recovery-planner.git
git push -u origin main
