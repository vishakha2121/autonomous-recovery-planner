├── frontend/ # React frontend
│ └── src/
│ ├── components/
│ ├── pages/
│ ├── api/
│ ├── hooks/
│ └── context/
├── database/ # SQL schema & seed data
├── docs/ # Documentation
└── scripts/ # Start scripts

